.env
# Any variant: .env.bak.20260914, .env.local, .env.openai. These hold
# live API keys and a bare `.env` rule does not match them.
.env.*
!.env.example
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.vscode/
.DS_Store

# Corpus and index: large, regenerable from data/manifest.json
data/raw/
data/parsed/
data/index/
!data/manifest.json
data/*.db
data/export/
eval/runs/
