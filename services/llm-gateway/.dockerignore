# Version control
.git
.gitignore
.github

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Virtual environments — CRITICAL (huge + host-specific, would break the image)
.venv/
venv/
env/
ENV/

# Secrets — CRITICAL
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
service-account*.json

# Local data / indexes — belong in a volume, not the image
data/
*.db
*.sqlite3
chroma/
.chroma/
qdrant_storage/
faiss_index/
storage/
*.faiss
*.index

# Models / downloaded weights
models/
*.gguf
*.bin
*.safetensors

# Logs, notebooks, editor junk
*.log
logs/
notebooks/
.ipynb_checkpoints/
.idea/
.vscode/
.DS_Store

# Docker files themselves
Dockerfile*
docker-compose*.yml
.dockerignore

# Docs
README.md
docs/