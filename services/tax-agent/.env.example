APP_NAME=Tax Agent
APP_VERSION=0.1.0

ENVIRONMENT=development
LOG_LEVEL=INFO

# Compose: http://llm-gateway:8000   ECS (same task): http://localhost:8000
LLM_GATEWAY_URL=http://localhost:8000
LLM_GATEWAY_TIMEOUT_SECONDS=60

# Set by the indexing script; surfaced in every answer so users can see
# how current the law is.
CORPUS_DATE=unknown
