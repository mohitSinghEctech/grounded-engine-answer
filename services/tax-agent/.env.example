APP_NAME=Tax Agent
APP_VERSION=0.1.0

ENVIRONMENT=development
LOG_LEVEL=INFO

# Compose: http://llm-gateway:8000   ECS (same task): http://localhost:8000
LLM_GATEWAY_URL=http://localhost:8000
LLM_GATEWAY_TIMEOUT_SECONDS=60

# Set by the indexing script; surfaced in every answer so users can see
# how current the law is.
CORPUS_DATE=unknown
# Compose overrides this with http://qdrant:6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ita_sections
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536
EMBEDDING_API_KEY=sk-...
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.30